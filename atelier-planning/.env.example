# Copiez ce fichier en .env puis complétez-le. Ne commitez jamais le fichier .env.

# --- WhatsApp Business Cloud API (Meta) ---
# Jeton d'accès permanent (utilisateur système Meta Business)
WHATSAPP_TOKEN=
# Identifiant du numéro WhatsApp (« Phone number ID » dans le gestionnaire Meta)
WHATSAPP_PHONE_NUMBER_ID=
# Jeton libre de votre choix, à recopier dans la configuration du webhook Meta
WHATSAPP_VERIFY_TOKEN=
# « Clé secrète de l'app » Meta : permet de vérifier que les webhooks viennent bien de Meta
WHATSAPP_APP_SECRET=

# --- Serveur ---
PORT=3000
TZ=Europe/Paris
